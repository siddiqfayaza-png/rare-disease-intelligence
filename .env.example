# Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
# DO NOT commit real secrets, private keys, or clinical credentials to version control.

# Application Environment (development, testing, production)
APP_ENV=development

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Local filesystem storage paths (relative to project root or absolute)
DATA_DIR=./data
CACHE_DIR=./data/cache
BENCHMARK_DIR=./data/benchmarks

# Future module placeholders (inactive in Phase 0)
# EXTERNAL_DATA_TIMEOUT_SECONDS=30
# MAX_CANDIDATE_DISEASES=50
